//@version=5
strategy("EMA Cross w/ Trade Numbers", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=100)

// --- INPUTS ---
rvolThreshold = input.float(2.0, title="Relative Volume Threshold")
volLength = input.int(12, title="Volume MA Length for RVOL")
minPrice = input.float(100.0, title="Minimum Price")
tpPercent = input.float(24.0, title="Take Profit Target (%)")

// --- INDICTATOR SECTION ---
ema9 = ta.ema(close, 9)
ema200 = ta.ema(close, 200)

plot(ema9, color=color.blue, title="EMA 9")
plot(ema200, color=color.red, title="EMA 200", linewidth=2)

// --- RELATIVE VOLUME CALCULATION ---
AvgVol = ta.sma(volume, volLength)
rvol = AvgVol[1] > 0 ? volume / AvgVol[1] : 0

// Keep RVOL visible in the Data Window for debugging/tracking
plot(rvol, title="Relative Volume", color=color.gray, display=display.data_window + display.status_line)

// --- ENTRY CONDITIONS ---
crossUp = ta.crossover(close, ema9)
priceCondition = close > minPrice
rvolCondition = rvol > rvolThreshold
trendCondition = close > ema200

longCondition = (crossUp and priceCondition and rvolCondition and trendCondition)

// Green background for Entries
bgcolor(longCondition ? color.new(color.green, 85) : na, title="Entry Vertical Line")

// --- STRATEGY EXECUTION & COMPACT LABELS ---
var int tradeNum = 0 

if longCondition 
    tradeNum += 1 
    
    // Create a unique ID for every trade (e.g., Long_1, Long_2)
    entryId = "Long_" + str.tostring(tradeNum)
    
    // Minimalist label
    label.new(bar_index, na, "#" + str.tostring(tradeNum), color=color.green, textcolor=color.white, style=label.style_label_up, yloc=yloc.belowbar, size=size.small)
        
    tradeComment = str.format("RVOL: {0,number,#.##}", rvol)
    log.info("BUY #{0} TRIGGERED | Price: {1} | RVOL: {2}", tradeNum, close, rvol)
    
    // Execute the entry using the unique ID
    strategy.entry(entryId, strategy.long, comment=tradeComment)
    
    // Immediately attach an independent Take Profit exit to this specific ID
    tpPrice = close * (1 + (tpPercent / 100))
    strategy.exit("TP_" + str.tostring(tradeNum), from_entry=entryId, limit=tpPrice, comment="TP Hit")